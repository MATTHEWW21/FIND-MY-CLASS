# Copia este archivo como .env (en la raiz del proyecto) y llena los valores. NUNCA subas el .env a Git.
PORT=3000
NODE_ENV=development

DB_HOST=postgres_db
DB_USER=uag_admin
DB_PASSWORD=cambia_esto
DB_NAME=findmyclass_db
DB_PORT=5432

# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Llave para acciones de administrador (crear edificios). Minimo 16 caracteres; generala igual que el JWT_SECRET
ADMIN_API_KEY=

# Telefono de seguridad del campus (para el boton SOS). Con lada, solo digitos y +, por ejemplo +523312345678
SEGURIDAD_UAG_TELEFONO=

# Botones de ayuda del SOS segun el tipo de problema. Si los dejas vacios se usan: psicologo = Linea de la Vida (800 911 2000), proteccion civil y medico = 911.
# Cuando la UAG tenga sus numeros propios (psicologia, servicio medico), ponlos aqui. Solo digitos y +.
PSICOLOGO_TELEFONO=
PROTECCION_CIVIL_TELEFONO=
MEDICO_TELEFONO=

# Solo se aceptan registros con este dominio de correo
DOMINIO_INSTITUCIONAL=edu.uag.mx

# SOLO DESARROLLO: la API devuelve el codigo de 6 digitos en la respuesta (no hay correo todavia).
# Se ignora si NODE_ENV=production.
DEV_MOSTRAR_CODIGO=true

# Solo si usas un tunel HTTPS (cloudflared) o un proxy delante del servidor: pon 1. Si no, dejalo comentado.
# TRUST_PROXY=1

# Solo en produccion: dominio desde el que se sirve la app, por ejemplo https://uagps.uag.mx
# CORS_ORIGIN=
